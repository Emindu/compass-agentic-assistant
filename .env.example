# Copy to .env and fill in. Never commit .env.

# --- LLM (any provider supported by LangChain init_chat_model) ---
LLM_PROVIDER=mistralai
MISTRAL_API_KEY=
LLM_MODEL=mistral-large-latest          # supervisor, response, RLM reduce
FAST_LLM_MODEL=mistral-small-latest     # input guard, RLM batch map, citation check
CODE_LLM_MODEL=codestral-latest         # RLM planner (writes the Python search plan)
CODE_LLM_FALLBACK=codestral-latest      # used if CODE_LLM_MODEL is unavailable
LLM_MAX_CONCURRENCY=3                   # shared by ALL LLM calls (workspace-wide limits)
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=4

# --- Pinecone (free tier is enough; embeddings are hosted by Pinecone) ---
PINECONE_API_KEY=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DENSE_INDEX=compass-dense
PINECONE_SPARSE_INDEX=compass-sparse
HYBRID_ALPHA=0.6
# Hosted cross-encoder after fusion; on failure search keeps the fused order.
RERANK_ENABLED=true
RERANK_MODEL=bge-reranker-v2-m3
RERANK_TIMEOUT_S=5
RERANK_CANDIDATES=20

# --- LangSmith (tracing is mandatory for this project) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=compass-agentic-assistant
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for EU workspaces

# --- Auth / rate limiting ---
JWT_SECRET=replace-with-a-long-random-string
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_S=0.2

# --- Fault injection for the failure-handling demo ---
FAULT_LLM=false
FAULT_PINECONE=false
FAULT_MCP=false
FAULT_TOOL_TIMEOUT=false

LOG_LEVEL=INFO
